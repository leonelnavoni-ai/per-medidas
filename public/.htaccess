# Apache & LiteSpeed Configuration for PER-Medidas
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to existing files and directories (including /api/ and uploads)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Specific API Endpoints
  RewriteRule ^api/login/?$ api/login.php [L,QSA]
  RewriteRule ^api/users/?(.*)$ api/users.php [L,QSA]
  RewriteRule ^api/measures/?(.*)$ api/measures.php [L,QSA]
  RewriteRule ^api/identifications/?(.*)$ api/identifications.php [L,QSA]
  RewriteRule ^api/upload-pdf/?$ api/upload-pdf.php [L,QSA]
  RewriteRule ^api/documents/?(.*)$ api/documents.php [L,QSA]

  # Generic API fallback if .php file exists
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^api/(.*)$ api/$1.php [L,QSA]

  # All other non-file requests route to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Security & CORS
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
